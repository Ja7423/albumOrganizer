# 複製成 fastlane/.env 後填入實際值（fastlane/.env 已在 .gitignore）。
# fastlane 執行時會自動載入，並傳給它呼叫的 asc。

# App Store Connect API Key（App Store Connect → 使用者與存取權限 → 整合 → App Store Connect API）
# 權限需要「App 管理」以上，match 才能建立憑證與 profile。
ASC_KEY_ID=
ASC_ISSUER_ID=

# 本機用 .p8 路徑；CI 改用 ASC_PRIVATE_KEY_B64（base64 -i AuthKey_XXX.p8）
ASC_PRIVATE_KEY_PATH=
# ASC_PRIVATE_KEY_B64=

# match 加密 cert repo 的密碼
MATCH_PASSWORD=
