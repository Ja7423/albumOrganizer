# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# fastlane 只負責簽章（match）與編譯（gym）；
# 上傳到 App Store Connect 交給 asc CLI（https://github.com/rorkai/App-Store-Connect-CLI）。
#
# 需要的環境變數見 fastlane/.env.example，fastlane 與 asc 共用同一組 ASC_* 變數。

require "json"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "albumOrganizer.xcodeproj")
PBXPROJ = File.join(PROJECT, "project.pbxproj")
SCHEME = "albumOrganizer"
TARGET = "albumOrganizer"
APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
TEAM_ID = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
OUTPUT_DIR = File.join(ROOT, "build")
IPA_NAME = "albumOrganizer.ipa"

platform :ios do
  before_all do
    # 只在 CI（環境變數 CI=true）生效：建立暫存 keychain 給 match 匯入憑證，並設成 readonly 模式。
    # 本機執行時什麼都不做。
    setup_ci
  end

  desc "載入 App Store Connect API Key，之後的 match 會自動使用"
  private_lane :asc_api_key do
    key_path = ENV["ASC_PRIVATE_KEY_PATH"]
    key_b64 = ENV["ASC_PRIVATE_KEY_B64"]
    UI.user_error!("請設定 ASC_PRIVATE_KEY_PATH 或 ASC_PRIVATE_KEY_B64") if key_path.to_s.empty? && key_b64.to_s.empty?

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      key_content: key_path.to_s.empty? ? key_b64 : nil,
      is_key_content_base64: key_path.to_s.empty?
    )
  end

  desc "下載開發用憑證與 profile（唯讀）"
  lane :certs do
    asc_api_key
    match(type: "development", readonly: true)
  end

  desc "下載上架用憑證與 profile（唯讀）"
  lane :certs_appstore do
    asc_api_key
    match(type: "appstore", readonly: true)
  end

  desc "第一次建立憑證與 profile 並推到 cert repo（新增裝置或憑證過期時也用這個）"
  lane :certs_init do
    asc_api_key
    match(type: "development", readonly: false)
    match(type: "appstore", readonly: false)
  end

  desc "修改 app 的版本號，寫入 project.pbxproj"
  desc "用法：fastlane ios set_version version:1.0.1"
  desc "build number 不寫入專案檔：build_appstore 編譯時會由 asc 查下一號（或用 build_number: 指定）並覆蓋"
  lane :set_version do |options|
    marketing_version = parse_version_option(options[:version])

    # 直接替換文字，而不是透過 xcodeproj gem 存檔：gem 會重寫其他物件的註解，diff 會混入無關變更。
    # 所有 target（含未來的 App Extension）一起更新，Apple 要求 extension 的版本號與主 app 一致。
    content = File.read(PBXPROJ)
    UI.user_error!("project.pbxproj 裡找不到 MARKETING_VERSION") unless content.include?("MARKETING_VERSION = ")

    File.write(PBXPROJ, content.gsub(/MARKETING_VERSION = [^;]+;/, "MARKETING_VERSION = #{marketing_version};"))
    UI.success("版本號 → #{marketing_version}")
  end

  desc "編譯 App Store 版本的 ipa，輸出到 build/"
  desc "選項：build_number:<n>（未指定則向 App Store Connect 查下一號）"
  lane :build_appstore do |options|
    asc_api_key
    match(type: "appstore", readonly: true)

    build_number = options[:build_number] || next_build_number
    profile_name = ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name")

    # 專案的 Release 已指定 match AppStore profile；這裡再依 match 實際下載的 profile 名稱設定一次，
    # 確保 identity 與 profile 一致。編譯結束後還原，不會留下 project.pbxproj 的變更（也不會蓋掉你尚未 commit 的修改）。
    original_pbxproj = File.read(PBXPROJ)
    begin
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        targets: [TARGET],
        build_configurations: ["Release"],
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name
      )

      gym(
        project: PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        export_options: {
          provisioningProfiles: { APP_IDENTIFIER => profile_name }
        },
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
        output_directory: OUTPUT_DIR,
        output_name: IPA_NAME
      )
    ensure
      File.write(PBXPROJ, original_pbxproj)
    end

    UI.success("已輸出 #{File.join(OUTPUT_DIR, IPA_NAME)}（build #{build_number}）")
    build_number
  end

  desc "編譯並用 asc 上傳到 App Store Connect / TestFlight"
  desc "選項：build_number:<n>、wait:true（等 Apple 處理完成）"
  lane :beta do |options|
    build_number = build_appstore(build_number: options[:build_number])
    upload_with_asc(ipa: File.join(OUTPUT_DIR, IPA_NAME), wait: options[:wait])
    write_github_outputs(version: marketing_version, build_number: build_number)
  end

  desc "只上傳已編譯好的 ipa（預設 build/albumOrganizer.ipa）"
  desc "選項：ipa:<path>、wait:true"
  lane :upload do |options|
    upload_with_asc(ipa: options[:ipa] || File.join(OUTPUT_DIR, IPA_NAME), wait: options[:wait])
  end

  desc "用 asc 上傳 ipa"
  private_lane :upload_with_asc do |options|
    ipa = File.expand_path(options[:ipa], ROOT)
    UI.user_error!("找不到 ipa：#{ipa}") unless File.exist?(ipa)

    command = ["asc", "builds", "upload", "--app", APP_IDENTIFIER, "--ipa", ipa, "--output", "table"]
    command += options[:wait].to_s == "true" ? ["--wait"] : ["--verify-timeout", "60s"]
    sh(*command)
  end
end

# 驗證並回傳版本號。Apple 規定最多三段、以 . 分隔的整數。
def parse_version_option(value)
  UI.user_error!("請指定版本，例如 version:1.0.1") if value.to_s.empty?
  if value.to_s.include?(":")
    UI.user_error!("set_version 只修改版本號，build number 由 build_appstore 編譯時決定（BUILD_NUMBER= 或 asc 查下一號）")
  end
  UI.user_error!("版本號格式錯誤：#{value}（例如 1.0.1）") unless value.to_s =~ /\A\d+(\.\d+){0,2}\z/

  value.to_s
end

# 讀 project.pbxproj 裡的 MARKETING_VERSION（所有 target 一致，取第一個即可）。
def marketing_version
  File.read(PBXPROJ)[/MARKETING_VERSION = ([^;]+);/, 1] ||
    UI.user_error!("project.pbxproj 裡找不到 MARKETING_VERSION")
end

# 在 GitHub Actions 上把值寫進 $GITHUB_OUTPUT 給後續 step 使用；本機沒有這個變數，什麼都不做。
def write_github_outputs(values)
  path = ENV["GITHUB_OUTPUT"]
  return if path.to_s.empty?

  File.open(path, "a") { |file| values.each { |key, value| file.puts("#{key}=#{value}") } }
end

# 向 App Store Connect 查下一個可用的 build number（包含處理中的上傳）。
def next_build_number
  output = sh(
    "asc", "builds", "next-build-number",
    "--app", APP_IDENTIFIER, "--platform", "IOS", "--output", "json",
    log: false
  )
  JSON.parse(output).fetch("nextBuildNumber").to_s
end
